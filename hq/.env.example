# --- Required ---------------------------------------------------------------
# Postgres connection string. Railway fills this in for you automatically.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hq

# The public address of the app (no trailing slash).
APP_URL=http://localhost:3000

# Your email. The seed script makes this person Owner of every workspace.
OWNER_EMAIL=andrewslymac@gmail.com

# --- Google sign-in (leave blank to use "dev login" locally) ----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only allow sign-ins from these email domains (comma separated).
# Leave blank to allow any Google account that has been invited.
ALLOWED_EMAIL_DOMAINS=

# Dev login lets you sign in with just an email, no password. NEVER enable in
# production. It is automatically off when NODE_ENV=production unless this is "true".
ALLOW_DEV_LOGIN=
