# Copy this file to .env and fill in your values.
# See README.md "QuickBooks Developer Setup" for how to get these.

# --- App ---
# Random long string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-value

# Where the SQLite database file lives.
DATABASE_URL=sqlite:///./data/vending.db

# The base URL this app is reachable at (used to build the QuickBooks
# OAuth redirect URI). If you're running locally this is fine as-is.
APP_BASE_URL=http://localhost:8000

# --- QuickBooks Online ---
# From your app on https://developer.intuit.com -> Keys & OAuth
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# "sandbox" while developing/testing, "production" once you're ready to
# sync real transactions into your real QuickBooks company file.
QBO_ENVIRONMENT=sandbox
