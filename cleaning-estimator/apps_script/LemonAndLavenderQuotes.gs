// Lemon and Lavender Cleaning Co. — Quote tools for the LL Residential Estimator.
// GENERATED by build_estimator.py so the cell addresses always match the Sheet. Don't hand-edit addresses.
// Install: in the Sheet, Extensions > Apps Script, replace everything with this file, Save, then reload the Sheet.
// A "Lemon and Lavender" menu appears with: Save quote, and Clear Quote tab for the next client.

const FIELDS = [["Saved at", "now", "", ""], ["Quoted by", "user", "", ""], ["Client", "cell", "Breakdown", "C5"], ["Jobber Request ID", "req_id", "", ""], ["Jobber Link", "req_link", "", ""], ["Street", "cell", "Breakdown", "C6"], ["City", "cell", "Breakdown", "C7"], ["Sq ft", "cell", "Breakdown", "C8"], ["Bedrooms", "cell", "Breakdown", "C9"], ["Bathrooms", "cell", "Breakdown", "C10"], ["People", "cell", "Breakdown", "C11"], ["Dogs", "cell", "Breakdown", "C12"], ["Cats", "cell", "Breakdown", "C13"], ["Other animals", "cell", "Breakdown", "C14"], ["Last professional cleaning", "cell", "Quote", "C22"], ["Dirt code used", "cell", "Breakdown", "C18"], ["Photo price change", "cell", "Quote", "C31"], ["Photo reason", "cell", "Quote", "C32"], ["Fridge", "cell", "Breakdown", "C22"], ["Oven", "cell", "Breakdown", "C23"], ["Windows", "cell", "Breakdown", "C24"], ["Promo $", "cell", "Breakdown", "C25"], ["Custom type", "cell", "Quote", "C42"], ["Custom areas", "cell", "Breakdown", "C83"], ["Custom sq ft", "cell", "Breakdown", "C81"], ["Custom extra hrs", "cell", "Breakdown", "C82"], ["Initial Deep Low", "cell", "Quote", "H8"], ["Initial Deep Recommended", "cell", "Quote", "I8"], ["Initial Deep High", "cell", "Quote", "J8"], ["Initial Deep Your price", "cell", "Quote", "K8"], ["Initial Deep In quote?", "cell", "Quote", "M8"], ["Deluxe Deep Low", "cell", "Quote", "H9"], ["Deluxe Deep Recommended", "cell", "Quote", "I9"], ["Deluxe Deep High", "cell", "Quote", "J9"], ["Deluxe Deep Your price", "cell", "Quote", "K9"], ["Deluxe Deep In quote?", "cell", "Quote", "M9"], ["Move-In/Out Low", "cell", "Quote", "H10"], ["Move-In/Out Recommended", "cell", "Quote", "I10"], ["Move-In/Out High", "cell", "Quote", "J10"], ["Move-In/Out Your price", "cell", "Quote", "K10"], ["Move-In/Out In quote?", "cell", "Quote", "M10"], ["Weekly Low", "cell", "Quote", "H12"], ["Weekly Recommended", "cell", "Quote", "I12"], ["Weekly High", "cell", "Quote", "J12"], ["Weekly Your price", "cell", "Quote", "K12"], ["Weekly In quote?", "cell", "Quote", "M12"], ["Bi-Weekly Low", "cell", "Quote", "H13"], ["Bi-Weekly Recommended", "cell", "Quote", "I13"], ["Bi-Weekly High", "cell", "Quote", "J13"], ["Bi-Weekly Your price", "cell", "Quote", "K13"], ["Bi-Weekly In quote?", "cell", "Quote", "M13"], ["Monthly Low", "cell", "Quote", "H14"], ["Monthly Recommended", "cell", "Quote", "I14"], ["Monthly High", "cell", "Quote", "J14"], ["Monthly Your price", "cell", "Quote", "K14"], ["Monthly In quote?", "cell", "Quote", "M14"], ["Custom Low", "cell", "Quote", "H15"], ["Custom Recommended", "cell", "Quote", "I15"], ["Custom High", "cell", "Quote", "J15"], ["Custom Your price", "cell", "Quote", "K15"], ["Custom In quote?", "cell", "Quote", "M15"], ["Add-ons total", "cell", "Quote", "I16"], ["Quote message", "cell", "Quote", "G19"]];
const PRICE_ROWS = [[8, "Initial Deep Clean"], [9, "Deluxe Deep Clean"], [10, "Move-In/Move-Out"], [12, "Weekly"], [13, "Bi-Weekly"], [14, "Monthly"], [15, "Custom"]];
const ROW_FOUND = ["Breakdown", "C64"];
const CLEAR_CELLS = ["C7", "C8", "C9", "C10", "C15", "C16", "C17", "C18", "C19", "C20", "C21", "C22", "C23", "C27", "C28", "C30", "C31", "C32", "C39", "C42", "B44", "C44", "D44", "B45", "C45", "D45", "B46", "C46", "D46", "B47", "C47", "D47", "B48", "C48", "D48", "B49", "C49", "D49", "K8", "K9", "K10", "K12", "K13", "K14", "K15"];
const RESET = {"C36": "No", "C37": "No", "C38": 0, "M8": "Yes", "M9": "Yes", "M10": "Yes", "M12": "Yes", "M13": "Yes", "M14": "Yes", "M15": "Yes"};

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('Lemon and Lavender')
    .addItem('💾 Save quote', 'saveQuote')
    .addItem('🧹 Clear Quote tab for the next client', 'clearQuote')
    .addToUi();
}

function saveQuote() {
  const ss = SpreadsheetApp.getActive();
  const ui = SpreadsheetApp.getUi();
  const quote = ss.getSheetByName('Quote');
  const status = quote.getRange('B2').getDisplayValue();
  if (status.indexOf('Ready to quote') === -1) {
    ui.alert('Not saved', 'The status bar must say "Ready to quote" first.\n\n' + status, ui.ButtonSet.OK);
    return;
  }
  let who = Session.getActiveUser().getEmail();
  if (!who) {
    const answer = ui.prompt('Save quote', 'Your name or initials:', ui.ButtonSet.OK_CANCEL);
    if (answer.getSelectedButton() !== ui.Button.OK) return;
    who = answer.getResponseText().trim();
  }
  const read = (sheet, a1) => ss.getSheetByName(sheet).getRange(a1).getDisplayValue();
  const requests = ss.getSheetByName('Requests');
  const reqRow = Number(read(ROW_FOUND[0], ROW_FOUND[1])) || 0;
  const now = new Date();
  const tz = ss.getSpreadsheetTimeZone();

  const record = FIELDS.map(([header, kind, sheet, a1]) => {
    if (kind === 'now') return Utilities.formatDate(now, tz, 'M/d/yyyy h:mm a');
    if (kind === 'user') return who;
    if (kind === 'req_id') return reqRow ? requests.getRange(reqRow, 2).getDisplayValue() : '';
    if (kind === 'req_link') return reqRow ? requests.getRange(reqRow, 3).getDisplayValue() : '';
    return read(sheet, a1);
  });
  ss.getSheetByName('Quote History').appendRow(record);

  // What went into the quote: services marked "Yes" that have a price.
  const quoted = [];
  PRICE_ROWS.forEach(([r, name]) => {
    const recommended = quote.getRange('I' + r).getDisplayValue();
    if (quote.getRange('M' + r).getDisplayValue() !== 'Yes' || recommended === '—' || recommended === '') return;
    const yours = quote.getRange('K' + r).getDisplayValue();
    quoted.push([name, yours || recommended]);
  });

  if (reqRow) {
    // Requests columns O..S: Status, Service Quoted, Price Quoted, Quoted By, Date Quoted
    requests.getRange(reqRow, 15, 1, 5).setValues([[
      'Quote sent',
      quoted.map((q) => q[0]).join(', '),
      quoted.map((q) => q[0] + ' ' + q[1]).join(' · '),
      who,
      Utilities.formatDate(now, tz, 'M/d/yyyy'),
    ]]);
  }
  ui.alert('Quote saved', 'Saved to the Quote History tab' +
    (reqRow ? ' and logged on the Requests tab.' : '. No Jobber request was picked, so the Requests tab was not updated.'),
    ui.ButtonSet.OK);
}

function clearQuote() {
  const ui = SpreadsheetApp.getUi();
  const answer = ui.alert('Clear the Quote tab?',
    'Did you save this quote first? This clears everything typed on the Quote tab.', ui.ButtonSet.YES_NO);
  if (answer !== ui.Button.YES) return;
  const quote = SpreadsheetApp.getActive().getSheetByName('Quote');
  CLEAR_CELLS.forEach((a1) => quote.getRange(a1).clearContent());
  Object.keys(RESET).forEach((a1) => quote.getRange(a1).setValue(RESET[a1]));
  quote.activate();
  quote.getRange('C7').activate();
}
